# Public business contact address (kept for reference; submissions now use the API).
NEXT_PUBLIC_CONTACT_EMAIL=

# Canonical production URL used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=

# Supabase project settings. The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email addresses permitted to access /admin.
ADMIN_EMAILS=
